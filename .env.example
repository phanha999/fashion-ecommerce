VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-public-storefront-access-token
VITE_SHOPIFY_API_VERSION=2026-07

# Public client ID from the Shopify Headless sales channel
VITE_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your-customer-account-client-id
# Must be an HTTPS URL registered in Shopify Customer Account API settings
VITE_SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=https://your-tunnel-domain.example/account
